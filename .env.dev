# Development environment
# Application
APP_NAME=nest-backend
APP_PORT=3000
APP_PREFIX=api

# Database (PostgreSQL) —— 用 docker-compose 起的容器（postgres/postgres，库名 nest_backend_dev）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nest_backend_dev
DB_LOGGING=false

# Redis —— 用 docker-compose 起的容器（无密码）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT    
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@example.com
MAIL_SECURE=false

# SMS
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# File Storage
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=./uploads

APP_ENV=dev
# DB_NAME=nest_backend_dev
# DB_LOGGING=true
# REDIS_DB=0
