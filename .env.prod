# Production environment - OVERRIDE all values below before deploying!
#
# Copy this file to .env.local and fill in production values.
#
APP_ENV=prod
APP_NAME=nest-backend
APP_PORT=3000
APP_PREFIX=api

# Database (PostgreSQL) - REPLACE THESE
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=nest_backend_prod
DB_LOGGING=false

# Redis - REPLACE THESE
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# JWT - REPLACE THESE with strong random secrets
JWT_ACCESS_SECRET=REPLACE-WITH-STRONG-SECRET
JWT_REFRESH_SECRET=REPLACE-WITH-STRONG-SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@yourdomain.com
MAIL_SECURE=true

# SMS
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# File Storage
FILE_STORAGE_DRIVER=s3
FILE_STORAGE_LOCAL_DIR=./uploads
FILE_STORAGE_S3_BUCKET=your-bucket
FILE_STORAGE_S3_REGION=us-east-1
