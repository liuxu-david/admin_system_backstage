# Copy to /opt/admin-system-test/.env, replace placeholders, chmod 600.
# Literal KEY=value only; optional matching single/double quotes, no interpolation,
# export, multiline values or inline comments. Never source this file.
# Generate EACH secret separately with: openssl rand -hex 32
# The script rejects placeholders and secrets shorter than 32 characters.
BACKEND_REPOSITORY=ghcr.io/liuxu-david/admin_system_backstage
FRONTEND_REPOSITORY=ghcr.io/liuxu-david/admin_system_front

DB_NAME=admin_system_test
# The official PG initialization role is a SUPERUSER, not least-privileged.
# This single-role setup is for this isolated test environment only.
DB_USERNAME=admin_test
DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_DB_SECRET
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_REDIS_SECRET
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_REFRESH_SECRET

# Default access: local SSH tunnel, localhost:18080 -> server 127.0.0.1:8080.
CORS_ORIGINS=http://127.0.0.1:18080

# NO BACKEND_IMAGE/FRONTEND_IMAGE here: bootstrap creates atomic images.env.
# APP_ENV=test, RUN_MIGRATIONS=true and resource limits are fixed in compose.yml.
